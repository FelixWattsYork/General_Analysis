# Shared presentation defaults. Keep figure-specific scientific choices in notebooks.
figure.figsize: 7, 5
figure.dpi: 110
figure.constrained_layout.use: True
font.size: 11
axes.titlesize: 12
axes.labelsize: 12
axes.grid: True
axes.axisbelow: True
grid.alpha: 0.3
grid.color: grey
lines.linewidth: 1.8
lines.markersize: 6
lines.marker: o
legend.frameon: False
legend.fontsize: 10
savefig.dpi: 300
savefig.bbox: tight
savefig.format: png
